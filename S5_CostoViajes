Algoritmo CostoViajes ()
//Declaraciones
    Definir distancia, consumo, precio_Combustible como real
    Definir num_Peajes como entero
    Definir costo_Peaje, litros, costo_Combustible, costo_Peajes, costo_Total como real

//Cuerpo
    Escribir "Ingrese la distancia del viaje (km): "
    Leer distancia
    Escribir "Ingrese el consumo del auto (km/l): "
    Leer consumo
    Escribir "Ingrese el precio del combustible por litro: "
    Leer precioCombustible
    Escribir "Ingrese el número de peajes: "
    Leer numPeajes
    Escribir "Ingrese el costo unitario de cada peaje: "
    Leer costoPeaje

    litros <- distancia / consumo
    costo_Combustible <- litros * precio_Combustible
    costo_Peajes <- num_Peajes * costo_Peaje
    costo_Total <- costo_Combustible + costo_Peajes

    Escribir "Litros necesarios: ", litros
    Escribir "Costo del combustible: ", costo_Combustible
    Escribir "Costo de peajes: ", costo_Peajes
    Escribir "Costo Total del viaje: ", costo_Total
FinAlgoritmo
